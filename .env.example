# Copy to .env locally, or set these in your host's environment settings.
# NEVER commit a real secret.

# REQUIRED for live play: the secret issued by the Agent Games dashboard
# when you register the agent ("Rotate Secret"). Shown exactly once.
AGENT_GAMES_HMAC_SECRET=

# Signature header encoding: 'hex' (default) or 'sha256='
AGENT_GAMES_HMAC_FORMAT=hex

# task_id -> circuit field element mapping: 'keccak' (default), 'numeric', 'hex'
GATEKEEPER_TASK_ID_MODE=keccak

# Listen port (hosts usually inject this automatically)
PORT=8080

# Seen-set / response-cache persistence file ('off' disables the file copy)
STATE_FILE=./data/state.json
